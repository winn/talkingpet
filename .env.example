# Copy to .env and fill in from the Supabase dashboard (Project Settings > API).
# These two are public and ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (Vercel functions in /api). Never prefix these with VITE_.
# Secret key (or legacy service_role JWT): instant sign-up and crediting paid points.
SUPABASE_SECRET_KEY=sb_secret_...
# Stripe: point packs are sold with Checkout; the webhook adds points after payment.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Botnoi Voice API — create agents + register tools (incl. MCP).
# Token is a Botnoi Voice console bearer token (API keys not public yet).
# Docs: https://voicebot-stg.botnoigroup.com/llms.txt
BOTNOI_VOICE_TOKEN=
BOTNOI_VOICE_API_BASE=https://api-voicebot-stg.botnoigroup.com

# Playwright end-to-end tests sign in with this account (create it once in the app).
E2E_EMAIL=
E2E_PASSWORD=
